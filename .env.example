# Frontend (Vite) — safe to expose, this is the public anon key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SITE_URL=          # your app's public URL, e.g. https://your-app.vercel.app — used for subscribe links

# Backend only — set these as Supabase Edge Function secrets,
# NEVER put them in a Vite env var or commit them.
# (supabase secrets set KEY=value)
#
# SUPABASE_SERVICE_ROLE_KEY=
# SENDGRID_API_KEY=
# FROM_EMAIL=
# FROM_NAME=
# APOLLO_API_KEY=
# SITE_URL=              # e.g. https://your-app.vercel.app — used to build confirm/unsubscribe links in emails
